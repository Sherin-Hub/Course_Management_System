# Copy to .env (local) or add these in Vercel -> Settings -> Environment Variables.
# Vite bakes them in at BUILD time: change them, then redeploy.

# ---- Local development ----
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_MOCK_API_URL=http://localhost:5001

# ---- Production example (use YOUR real Render URLs; no trailing slash) ----
# VITE_API_URL=https://your-backend.onrender.com/api/v1
# VITE_SOCKET_URL=https://your-backend.onrender.com
# VITE_MOCK_API_URL=https://your-mock-api.onrender.com
