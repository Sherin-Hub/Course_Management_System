# ---- Local development ----
PORT=5000
# The exact address of your React app. Several origins: comma-separated, NO trailing slash.
#   Local:       http://localhost:5173
#   Production:  https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production requires at least 32 characters.
JWT_SECRET=your_random_secret
JWT_EXPIRES_IN=1h
# Local MongoDB shown here. For MongoDB Atlas use the mongodb+srv://... string instead
# (never commit it; on Render put it in the Environment tab).
MONGO_URI=mongodb://127.0.0.1:27017/faceprep_course_system

# ---- Production only (set these in the Render dashboard, not in a file) ----
# NODE_ENV=production
# PORT is provided by Render - do not set it there.

# ---- Optional ----
# AUTO_SEED_COURSES=false      the 6 starter courses are added automatically when the
#                              courses collection is EMPTY (first start). Set to false to disable.
# LOGIN_RATE_LIMIT=10          failed logins per IP per 15 minutes
# ADMIN_EMAIL / ADMIN_PASSWORD  used only by `npm run seed` / `npm run create-admin`
